prefix=@CMAKE_INSTALL_PREFIX@
libdir=${prefix}/lib
includedir=${prefix}/include/imagedecoder

Name: imagedecoder
Description: Colour-managed still-image decoders
Version: @PROJECT_VERSION@
Requires.private: @IMAGEDECODER_PC_REQUIRES@
Libs: -L${libdir} -limagedecoder
Libs.private: @IMAGEDECODER_PC_LIBS_PRIVATE@
Cflags: -I${includedir}
